{
  "name": "CompanyVersionDecision",
  "type": "object",
  "description": "Platform-owned record representing a pending version update decision for a Company Job. Created exclusively by NEW_VERSION publishing orchestration via createVersionDecisionForCompanyJob(). No client writes permitted. One logical decision per (companyJobId, toVersionId) pair, enforced via deterministic decisionKey.",
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "companyId": {
      "type": "string",
      "description": "Company that owns the Company Job."
    },
    "companyJobId": {
      "type": "string",
      "description": "The stable Company Job ID (Job.id) this decision pertains to."
    },
    "masterId": {
      "type": "string",
      "description": "EssentialSOPMaster.id this Company Job was provisioned from."
    },
    "fromVersionId": {
      "type": "string",
      "description": "EssentialSOPVersion.id the Company Job is currently pinned to at decision creation time."
    },
    "toVersionId": {
      "type": "string",
      "description": "EssentialSOPVersion.id the Company Job is being offered an update to."
    },
    "distributionEventId": {
      "type": "string",
      "description": "DistributionEvent.id that triggered this decision."
    },
    "decisionKey": {
      "type": "string",
      "description": "Deterministic deduplication key: 'VERSION_DECISION:{companyJobId}:{toVersionId}'. Stored at creation; checked before any new record creation to prevent duplicates."
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "ACCEPTED",
        "DECLINED",
        "DEFERRED",
        "SUPERSEDED",
        "FAILED"
      ],
      "default": "PENDING",
      "description": "Lifecycle status of this version decision. PENDING = awaiting company action. ACCEPTED = company accepted the update (Edit 5B+). DECLINED = company declined the update (Edit 5B+). DEFERRED = company deferred the update (Edit 5B+). SUPERSEDED = a newer target version has been published and a new decision was created. FAILED = decision creation failed with an error."
    },
    "supersededByDecisionId": {
      "type": "string",
      "description": "If status=SUPERSEDED, the ID of the newer CompanyVersionDecision that replaced this one."
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when a company admin made a ACCEPTED/DECLINED/DEFERRED decision. Null for PENDING/SUPERSEDED/FAILED."
    },
    "decidedByUserId": {
      "type": "string",
      "description": "userId of the company admin who made the decision. Null until decided."
    },
    "decisionNote": {
      "type": "string",
      "description": "Optional note provided by the company admin at decision time."
    },
    "errorCode": {
      "type": "string",
      "description": "For status=FAILED: machine-readable error code."
    },
    "errorMessage": {
      "type": "string",
      "description": "For status=FAILED: human-readable error description."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdBy": {
      "type": "string",
      "description": "userId of the platform admin whose publication triggered this decision."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "companyId",
    "companyJobId",
    "masterId",
    "fromVersionId",
    "toVersionId",
    "distributionEventId",
    "decisionKey",
    "status",
    "createdAt",
    "createdBy"
  ]
}