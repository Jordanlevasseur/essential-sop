{
  "name": "EssentialSOPVersion",
  "type": "object",
  "description": "Platform Master SOP published version \u2014 immutable once published. All direct client access (read/create/update/delete) is blocked via RLS. Versions are created and read exclusively through platform super-admin backend functions (publishing orchestration, manageMasterSOP) and surfaced to companies only through the assignment-gated company preview resolver. Direct SDK reads would expose draft and published versions of every Master in the platform, including internal/retired content, so client access is denied entirely.",
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "masterId": {
      "type": "string",
      "description": "References EssentialSOPMaster.id"
    },
    "versionNumber": {
      "type": "number",
      "description": "Monotonically increasing integer. Once published, this record is immutable."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "publishedBy": {
      "type": "string",
      "description": "userId of the PlatformAdmin who published this version"
    },
    "changeNotes": {
      "type": "string",
      "description": "Human-readable summary of what changed in this version."
    },
    "publicationMutationKey": {
      "type": "string",
      "description": "Idempotency key supplied by the caller when publishing. Stored to detect and safely replay duplicate publication requests without creating another version."
    },
    "distributionEventId": {
      "type": "string",
      "description": "The DistributionEvent.id created alongside this version publication. Stored for cross-reference."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "masterId",
    "versionNumber",
    "status"
  ]
}