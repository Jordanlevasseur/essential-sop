{
  "name": "JobOverride",
  "type": "object",
  "description": "Company-owned override for a provisioned Essential SOP Job. All client writes (create, update, delete) are BLOCKED via RLS \u2014 only service-role writes via saveJobOverride are permitted. Reads are also blocked at entity level; the frontend receives override metadata exclusively through resolveJob and resolveJobsForCompany resolver responses.",
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "companyId": {
      "type": "string",
      "description": "Company that owns this override. Never supplied by the frontend \u2014 always derived server-side."
    },
    "jobId": {
      "type": "string",
      "description": "The stable company Job ID (Job.id). Never changes."
    },
    "deterministicKey": {
      "type": "string",
      "description": "Stable key 'override_${companyId}_${jobId}' stored at creation. Used for duplicate detection after a concurrent first-create race."
    },
    "sourceMasterId": {
      "type": "string",
      "description": "The EssentialSOPMaster.id this Job was provisioned from. Captured at override creation for audit."
    },
    "sourceVersionId": {
      "type": "string",
      "description": "The EssentialSOPVersion.id pinned at provisioning time. Captured at override creation for audit."
    },
    "overrideData": {
      "type": "object",
      "description": "The actual company override values. Allowed keys: title, shortDescription, sectionOverrides. Each sectionOverrides item carries a _itemId for stable nested identity.",
      "properties": {
        "title": {
          "type": "string"
        },
        "shortDescription": {
          "type": "string"
        },
        "sectionOverrides": {
          "type": "object",
          "description": "Map of sectionType to full replacement content array. Each item must have a _itemId for stable identity across saves and reorders."
        }
      }
    },
    "customizedFields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of field names the company has overridden."
    },
    "revision": {
      "type": "number",
      "default": 1,
      "description": "Monotonically increasing revision counter. Used for optimistic concurrency."
    },
    "mutationKey": {
      "type": "string",
      "description": "Idempotency key from the first save."
    },
    "lastMutationKey": {
      "type": "string",
      "description": "The most recently applied mutation key. Rejects re-submission of the same key."
    },
    "auditPending": {
      "type": "boolean",
      "default": false,
      "description": "True if the override was saved but the ActivityLog audit write failed. Enables retry to complete the missing audit record without re-applying the override."
    },
    "auditPendingRevision": {
      "type": "number",
      "description": "The revision for which the audit record is pending. Used to reconstruct the correct audit entry on retry."
    },
    "createdByUserId": {
      "type": "string",
      "description": "User who created this override."
    },
    "lastModifiedByUserId": {
      "type": "string",
      "description": "User who last saved this override."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "companyId",
    "jobId",
    "sourceMasterId",
    "sourceVersionId"
  ]
}