{
  "name": "JobOverride",
  "type": "object",
  "description": "Company-owned override for a provisioned Essential SOP Job. All client writes (create, update, delete) are BLOCKED via RLS \u2014 only service-role writes via saveJobOverride are permitted. Reads are also blocked at entity level; the frontend receives override metadata exclusively through resolveJob and resolveJobsForCompany resolver responses.",
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "companyId": {
      "type": "string",
      "description": "Company that owns this override. Never supplied by the frontend \u2014 always derived server-side."
    },
    "jobId": {
      "type": "string",
      "description": "The stable company Job ID (Job.id). Never changes."
    },
    "deterministicKey": {
      "type": "string",
      "description": "Stable key 'override_${companyId}_${jobId}' stored at creation. Used for duplicate detection after a concurrent first-create race."
    },
    "sourceMasterId": {
      "type": "string",
      "description": "The EssentialSOPMaster.id this Job was provisioned from. Captured at override creation for audit."
    },
    "sourceVersionId": {
      "type": "string",
      "description": "The EssentialSOPVersion.id currently reflected in this override. Updated to targetVersionId only after Step 3 completes."
    },
    "overrideData": {
      "type": "object",
      "description": "The actual company override values. Allowed keys: title, shortDescription, sectionOverrides. Each sectionOverrides item carries a _itemId for stable nested identity.",
      "properties": {
        "title": {
          "type": "string"
        },
        "shortDescription": {
          "type": "string"
        },
        "sectionOverrides": {
          "type": "object",
          "description": "Map of sectionType to full replacement content array. Each item must have a _itemId for stable identity across saves and reorders."
        }
      }
    },
    "customizedFields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of field names the company has overridden."
    },
    "revision": {
      "type": "number",
      "default": 1,
      "description": "Monotonically increasing revision counter. Used for optimistic concurrency."
    },
    "mutationKey": {
      "type": "string",
      "description": "Idempotency key from the first save."
    },
    "lastMutationKey": {
      "type": "string",
      "description": "The most recently applied mutation key. Rejects re-submission of the same key."
    },
    "lastAdoptionMutationKey": {
      "type": "string",
      "description": "The mutationKey of the most recently started or completed version adoption. Matches Job.lastAdoptionMutationKey when the three-step write is fully committed. Used for recovery routing: if this key matches the retry mutationKey, the engine can safely resume."
    },
    "rebaseIncomplete": {
      "type": "boolean",
      "default": false,
      "description": "Set to true at the start of Step 1 (override write) and cleared to false in Step 3 (after Job.sourceVersionId is pinned). If true, resolveJob blocks content resolution and returns ADOPTION_INCOMPLETE \u2014 the caller must retry adoptVersionFromAnalysis with the original mutationKey. A durable pre-set marker: written before the Job update so a crash between steps always leaves a detectable partial state."
    },
    "pendingTargetVersionId": {
      "type": "string",
      "description": "The EssentialSOPVersion.id the adoption is trying to pin on the Job. Set in Step 1 alongside rebaseIncomplete=true. Cleared in Step 3. Allows resolveJob to report which version is pending and allows the recovery router to verify the target has not changed."
    },
    "pendingAnalysisId": {
      "type": "string",
      "description": "The CompanyVersionAnalysis.id used to produce the current rebase. Set in Step 1 alongside rebaseIncomplete=true. Cleared in Step 3. Authoritative server-side recovery source: VersionAdoptionIncomplete reads this from the incomplete override record so recovery works even when localStorage is empty, cleared, or unavailable."
    },
    "auditPending": {
      "type": "boolean",
      "default": false,
      "description": "True if the adoption succeeded (Steps 1-3 complete) but the ActivityLog audit write failed. Persisted durably on the override so it survives process restarts. The API response also surfaces auditPending=true. Caller can retry the audit independently."
    },
    "auditPendingRevision": {
      "type": "number",
      "description": "The revision for which the audit record is pending. Used to reconstruct the correct audit entry on retry."
    },
    "createdByUserId": {
      "type": "string",
      "description": "User who created this override."
    },
    "lastModifiedByUserId": {
      "type": "string",
      "description": "User who last saved this override."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "companyId",
    "jobId",
    "sourceMasterId",
    "sourceVersionId"
  ]
}