{
  "name": "Job",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "shortDescription": {
      "type": "string"
    },
    "trade": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "skillLevel": {
      "type": "string",
      "enum": [
        "Entry",
        "Intermediate",
        "Advanced"
      ],
      "default": "Intermediate"
    },
    "estimatedDuration": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "thumbnail": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Published"
      ],
      "default": "Draft"
    },
    "isArchived": {
      "type": "boolean",
      "default": false
    },
    "sourceType": {
      "type": "string",
      "enum": [
        "company",
        "essential_sop"
      ],
      "default": "company",
      "description": "Hidden metadata: origin of this Job. 'company' = created directly by the company. 'essential_sop' = provisioned from the Essential SOP Master Library."
    },
    "sourceMasterId": {
      "type": "string",
      "description": "Hidden metadata: EssentialSOPMaster.id this Job was provisioned from. Null for company-created Jobs."
    },
    "sourceVersionId": {
      "type": "string",
      "description": "Hidden metadata: EssentialSOPVersion.id that was current when this Job was provisioned."
    },
    "isCustomized": {
      "type": "boolean",
      "default": false,
      "description": "Hidden metadata: true once a company has edited any content on an Essential SOP-sourced Job."
    },
    "customizedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Hidden metadata: timestamp of first company edit on an Essential SOP-sourced Job."
    },
    "customizedBy": {
      "type": "string",
      "description": "Hidden metadata: userId who made the first customization."
    }
  },
  "required": [
    "companyId",
    "title"
  ]
}