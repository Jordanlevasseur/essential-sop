{
  "name": "DeletionRequest",
  "type": "object",
  "description": "Unified deletion-request queue for TWO distinct workflows: (1) PERSONAL_ACCOUNT_DELETION \u2014 any authenticated user requests deletion of their own account; (2) COMPANY_DELETION \u2014 an active General Manager requests permanent deletion of their company workspace. ALL direct client access (read/create/update/delete) is blocked via RLS. Records are created ONLY by deleteAccount (personal) and requestCompanyClosure (company), both service-role, and read/processed ONLY by resolveDeletionRequests / manageDeletionRequest, which verify an active PlatformMembership(SUPER_ADMIN) on the backend. No frontend SDK call may list, read, modify, or delete these records. RECONCILIATION: pre-existing records have requestType=null and are treated as PERSONAL_ACCOUNT_DELETION (the original behavior); their status (Pending/Completed/Cancelled) is preserved unchanged. Lifecycle states: Pending (submitted, awaiting admin), Approved (company deletion \u2014 admin approved, awaiting irreversible execution), Rejected (company deletion \u2014 admin rejected), Completed (done), Cancelled (personal \u2014 admin dismissed), Failed (execution errored). Four independent signals per personal request: status, authIdentityDeletedAt (admin attestation), appDataDeletedAt (personal-data cleanup), notificationStatus (user completion notification). Company-deletion lifecycle is tracked via status + reviewerUserId/reviewedAt + completedAt.",
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "requestType": {
      "type": "string",
      "enum": [
        "PERSONAL_ACCOUNT_DELETION",
        "COMPANY_DELETION"
      ],
      "default": "PERSONAL_ACCOUNT_DELETION",
      "description": "Distinguishes the two deletion workflows. Null on pre-existing records is treated as PERSONAL_ACCOUNT_DELETION."
    },
    "userId": {
      "type": "string",
      "description": "For PERSONAL: the user deleting their own account. For COMPANY: the requesting General Manager (same as requestedByUserId)."
    },
    "userEmail": {
      "type": "string"
    },
    "userName": {
      "type": "string"
    },
    "requestedByUserId": {
      "type": "string",
      "description": "The authenticated user who submitted the request. For PERSONAL equals userId; for COMPANY equals the requesting GM."
    },
    "companyId": {
      "type": "string",
      "description": "For COMPANY_DELETION: the company whose deletion is requested. Null for PERSONAL."
    },
    "companyName": {
      "type": "string",
      "description": "For COMPANY_DELETION: snapshot of the company name at request time (used for typed-name confirmation and audit)."
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Rejected",
        "Completed",
        "Cancelled",
        "Failed"
      ],
      "default": "Pending"
    },
    "reviewerUserId": {
      "type": "string",
      "description": "Platform Super Admin who approved or rejected a COMPANY_DELETION request. Null for personal and until review."
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of approval or rejection for COMPANY_DELETION."
    },
    "rejectionReason": {
      "type": "string",
      "description": "Reason recorded when a COMPANY_DELETION request is rejected."
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "adminNotes": {
      "type": "string"
    },
    "appDataDeletedAt": {
      "type": "string",
      "format": "date-time",
      "description": "PERSONAL: set when manageDeletionRequest(action=complete) removes personal data. COMPANY: set when execute_company_deletion completes. Null while Pending/Approved. Independent of authIdentityDeletedAt and notificationStatus."
    },
    "authIdentityDeletedAt": {
      "type": "string",
      "format": "date-time",
      "description": "PERSONAL only: set when an administrator completes the deletion after attesting (authIdentityRemoved: true) that the authentication identity was removed via the Dashboard (manual, no API). A manual attestation, not an automatically verified platform event. Null while Pending. Not used for COMPANY_DELETION."
    },
    "notificationStatus": {
      "type": "string",
      "enum": [
        "pending",
        "email_sent",
        "email_failed",
        "admin_notified"
      ],
      "default": "pending",
      "description": "PERSONAL: status of the deletion-COMPLETION notification to the user. COMPANY: status of the lifecycle notification to the requesting GM. 'email_sent' = SendEmail delivery accepted. 'email_failed' = delivery NOT accepted. 'admin_notified' = admin recorded an alternative channel. 'pending' = none attempted yet."
    },
    "userNotifiedVia": {
      "type": "string",
      "description": "When notificationStatus='admin_notified', the verified channel used to inform the recipient."
    },
    "userNotifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "notificationError": {
      "type": "string",
      "description": "When notificationStatus='email_failed', the reason delivery was not accepted."
    },
    "closedCompanyIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "PERSONAL: company IDs closed (status='closed') during completion because the user was the sole owner and only active member. COMPANY: the company ID that was permanently deleted."
    }
  },
  "required": [
    "userId",
    "userEmail",
    "requestedAt",
    "status"
  ]
}