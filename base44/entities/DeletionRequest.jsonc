{
  "name": "DeletionRequest",
  "type": "object",
  "description": "Unified deletion-request queue for TWO distinct workflows: (1) PERSONAL_ACCOUNT_DELETION \u2014 any authenticated user requests deletion of their own account; (2) COMPANY_DELETION \u2014 an active General Manager requests permanent deletion of their company workspace. ALL direct client access (read/create/update/delete) is blocked via RLS. Records are created ONLY by deleteAccount (personal) and requestCompanyClosure (company), both service-role, and read/processed ONLY by resolveDeletionRequests / manageDeletionRequest, which verify an active PlatformMembership(SUPER_ADMIN) on the backend. No frontend SDK call may list, read, modify, or delete these records. RECONCILIATION: pre-existing records have requestType=null and are treated as PERSONAL_ACCOUNT_DELETION (the original behavior); their status (Pending/Completed/Cancelled) is preserved unchanged. Lifecycle states: Pending (submitted, awaiting admin), Approved (company deletion \u2014 admin approved, awaiting irreversible execution), CleanupPending (company deletion \u2014 operational data deleted, underlying private file content still outstanding provider cleanup), Rejected (company deletion \u2014 admin rejected), Completed (done), Cancelled (personal \u2014 admin dismissed), Failed (execution errored; idempotent retry allowed). Four independent signals per personal request: status, authIdentityDeletedAt (admin attestation), appDataDeletedAt (personal-data cleanup), notificationStatus. Company-deletion lifecycle is tracked via status + reviewerUserId/reviewedAt + completedAt + fileCleanupStatus + notificationStatus.",
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "requestType": {
      "type": "string",
      "enum": [
        "PERSONAL_ACCOUNT_DELETION",
        "COMPANY_DELETION"
      ],
      "default": "PERSONAL_ACCOUNT_DELETION",
      "description": "Distinguishes the two deletion workflows. Null on pre-existing records is treated as PERSONAL_ACCOUNT_DELETION."
    },
    "userId": {
      "type": "string",
      "description": "For PERSONAL: the user deleting their own account. For COMPANY: the requesting General Manager (same as requestedByUserId)."
    },
    "userEmail": {
      "type": "string"
    },
    "userName": {
      "type": "string"
    },
    "requestedByUserId": {
      "type": "string",
      "description": "The authenticated user who submitted the request. For PERSONAL equals userId; for COMPANY equals the requesting GM."
    },
    "companyId": {
      "type": "string",
      "description": "For COMPANY_DELETION: the company whose deletion is requested. Null for PERSONAL."
    },
    "companyName": {
      "type": "string",
      "description": "For COMPANY_DELETION: snapshot of the company name at request time (used for typed-name confirmation and audit)."
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "CleanupPending",
        "Rejected",
        "Completed",
        "Cancelled",
        "Failed"
      ],
      "default": "Pending",
      "description": "CleanupPending = company operational data deleted, underlying private file content still outstanding provider cleanup. Not marked Completed until file cleanup is confirmed."
    },
    "reviewerUserId": {
      "type": "string",
      "description": "Platform Super Admin who approved or rejected a COMPANY_DELETION request. Null for personal and until review."
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of approval or rejection for COMPANY_DELETION."
    },
    "rejectionReason": {
      "type": "string",
      "description": "Reason recorded when a COMPANY_DELETION request is rejected."
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "adminNotes": {
      "type": "string"
    },
    "appDataDeletedAt": {
      "type": "string",
      "format": "date-time",
      "description": "PERSONAL: set when manageDeletionRequest(action=complete) removes personal data. COMPANY: set when execute_company_deletion completes the metadata + company deletion. Independent of authIdentityDeletedAt and notificationStatus."
    },
    "authIdentityDeletedAt": {
      "type": "string",
      "format": "date-time",
      "description": "PERSONAL only: set when an administrator completes the deletion after attesting (authIdentityRemoved: true) that the authentication identity was removed via the Dashboard (manual, no API). A manual attestation, not an automatically verified platform event. Null while Pending. Not used for COMPANY_DELETION."
    },
    "notificationStatus": {
      "type": "string",
      "enum": [
        "pending",
        "email_sent",
        "email_failed",
        "admin_notified"
      ],
      "default": "pending",
      "description": "PERSONAL: status of the deletion-COMPLETION notification to the user. COMPANY: status of the lifecycle/completion notification to the requesting GM. 'email_sent' = SendEmail delivery accepted. 'email_failed' = delivery NOT accepted (retry via retry_company_completion_notification or record an alternative channel). 'admin_notified' = admin recorded an alternative verified channel. 'pending' = none attempted yet."
    },
    "userNotifiedVia": {
      "type": "string",
      "description": "When notificationStatus='admin_notified', the verified channel used to inform the recipient."
    },
    "userNotifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "notificationError": {
      "type": "string",
      "description": "When notificationStatus='email_failed', the reason delivery was not accepted."
    },
    "closedCompanyIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "PERSONAL: company IDs closed (status='closed') during completion because the user was the sole owner and only active member. COMPANY: the company ID that was permanently deleted."
    },
    "fileCleanupStatus": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "completed",
        "manual_required"
      ],
      "default": "none",
      "description": "COMPANY_DELETION only: tracks outstanding private file-content cleanup. 'none' = no private files were attached to the company. 'pending' = operational data deleted but underlying private file content (CompanyPdfAttachment.fileUri / Job.sourceDocumentUri) still requires provider cleanup; request stays CleanupPending. 'completed' = admin attested provider cleanup done; request transitioned to Completed. 'manual_required' = cleanup could not be completed automatically and awaits manual provider action. Base44 exposes no file-purge API; this field records the limitation without claiming a purge that did not occur."
    },
    "pendingFileUris": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "COMPANY_DELETION only: private file_uri values captured from CompanyPdfAttachment.fileUri and Job.sourceDocumentUri BEFORE their metadata records were deleted. Retained so the administrator can identify and complete outstanding file-content cleanup with the provider. Admin-only; never exposed to customers."
    },
    "fileCleanupNotes": {
      "type": "string",
      "description": "COMPANY_DELETION only: admin attestation/notes recorded when confirming provider file cleanup."
    },
    "fileCleanupCompletedAt": {
      "type": "string",
      "format": "date-time"
    },
    "fileCleanupCompletedBy": {
      "type": "string",
      "description": "userId of the Platform Super Admin who attested file-content cleanup was completed."
    },
    "executionErrors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "COMPANY_DELETION only: per-step error details when an execution partially fails (status=Failed). Lets the administrator identify exactly which cleanup steps remain before retrying. Cleared on successful completion."
    }
  },
  "required": [
    "userId",
    "userEmail",
    "requestedAt",
    "status"
  ]
}