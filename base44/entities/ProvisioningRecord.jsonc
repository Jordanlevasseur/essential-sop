{
  "name": "ProvisioningRecord",
  "type": "object",
  "description": "Tracks a single company-level provisioning action within a DistributionEvent. Created and controlled exclusively by platform backend services. Direct client writes are blocked. provisioningKey is deterministic: sha256-like concat of distributionEventId+companyId+masterId is not available in Base44 \u2014 use string key 'pr_${distributionEventId}_${companyId}_${masterId}' stored at creation for safe deduplication lookup.",
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "distributionEventId": {
      "type": "string",
      "description": "DistributionEvent.id this record belongs to."
    },
    "companyId": {
      "type": "string",
      "description": "Company targeted by this provisioning action."
    },
    "masterId": {
      "type": "string",
      "description": "EssentialSOPMaster.id being provisioned."
    },
    "versionId": {
      "type": "string",
      "description": "EssentialSOPVersion.id being provisioned."
    },
    "companyJobId": {
      "type": "string",
      "description": "The Job.id created for this company, if operation succeeded."
    },
    "provisioningKey": {
      "type": "string",
      "description": "Deterministic deduplication key: 'pr_${distributionEventId}_${companyId}_${masterId}'. Stored at creation; checked before any new record creation to prevent duplicates."
    },
    "operationType": {
      "type": "string",
      "enum": [
        "CREATE_NEW_COMPANY_JOB",
        "INITIAL_COMPANY_LIBRARY",
        "SKIP_ALREADY_PROVISIONED"
      ],
      "description": "The type of provisioning operation performed."
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "PROCESSING",
        "COMPLETED",
        "SKIPPED",
        "FAILED"
      ],
      "default": "PENDING"
    },
    "attemptCount": {
      "type": "number",
      "default": 0
    },
    "lastAttemptAt": {
      "type": "string",
      "format": "date-time"
    },
    "errorCode": {
      "type": "string"
    },
    "errorMessage": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "distributionEventId",
    "companyId",
    "masterId",
    "versionId",
    "provisioningKey",
    "operationType",
    "status",
    "createdAt"
  ]
}