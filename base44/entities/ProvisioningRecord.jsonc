{
  "name": "ProvisioningRecord",
  "type": "object",
  "description": "Canonical company-master assignment record. ONE record per (companyId, masterId) pair, keyed by provisioningKey = 'ESOP_PROVISION:{companyId}:{masterId}'. A COMPLETED record is the authoritative signal that this company has been assigned this Master SOP, regardless of how the assignment originated (distribution event, manual admin action, or company sync). The sync reads COMPLETED records as the source of truth for what to maintain \u2014 it does NOT re-evaluate distribution policy. distributionEventId is optional: MANUAL and sync-driven assignments have no associated DistributionEvent. Created and controlled exclusively by platform backend services. Direct client writes are blocked.",
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "distributionEventId": {
      "type": "string",
      "description": "DistributionEvent.id this record belongs to. Optional \u2014 null for MANUAL assignments and sync-driven provisions that have no associated distribution event."
    },
    "companyId": {
      "type": "string",
      "description": "Company targeted by this provisioning action."
    },
    "masterId": {
      "type": "string",
      "description": "EssentialSOPMaster.id being provisioned."
    },
    "versionId": {
      "type": "string",
      "description": "EssentialSOPVersion.id being provisioned."
    },
    "companyJobId": {
      "type": "string",
      "description": "The Job.id created for this company, if operation succeeded."
    },
    "provisioningKey": {
      "type": "string",
      "description": "Deterministic deduplication key: 'ESOP_PROVISION:{companyId}:{masterId}'. One key per (companyId, masterId) pair. Source-independent."
    },
    "operationType": {
      "type": "string",
      "enum": [
        "CREATE_NEW_COMPANY_JOB",
        "INITIAL_COMPANY_LIBRARY",
        "SKIP_ALREADY_PROVISIONED"
      ],
      "description": "The type of provisioning operation performed."
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "PROCESSING",
        "COMPLETED",
        "SKIPPED",
        "FAILED"
      ],
      "default": "PENDING"
    },
    "attemptCount": {
      "type": "number",
      "default": 0
    },
    "lastAttemptAt": {
      "type": "string",
      "format": "date-time"
    },
    "errorCode": {
      "type": "string"
    },
    "errorMessage": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "companyId",
    "masterId",
    "versionId",
    "provisioningKey",
    "operationType",
    "status",
    "createdAt"
  ]
}