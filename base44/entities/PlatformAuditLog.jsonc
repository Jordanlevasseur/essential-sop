{
  "name": "PlatformAuditLog",
  "type": "object",
  "description": "Immutable platform audit trail. All direct client access (read/create/update/delete) is blocked via RLS \u2014 entries are written by the platform via writePlatformAudit (service role) and surfaced to platform super-admins via platform audit backend functions. Direct client reads would expose platform administrative actions and target identifiers; direct writes would allow forging audit records.",
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "idempotencyKey": {
      "type": "string",
      "description": "Optional deterministic deduplication key. When present, writePlatformAudit checks for an existing record with this key before creating a new one. Format: '<actionType>_<mutationKey>' for rollback audits. Null for non-idempotent audit events."
    },
    "actingUserId": {
      "type": "string",
      "description": "userId of the platform admin who performed the action"
    },
    "actingUserRole": {
      "type": "string",
      "description": "Platform role of the acting user at time of action"
    },
    "action": {
      "type": "string",
      "enum": [
        "platform_role_assigned",
        "platform_role_removed",
        "master_sop_created",
        "master_sop_draft_updated",
        "master_sop_version_published",
        "master_sop_archived",
        "master_sop_deleted",
        "master_sop_duplicated",
        "master_sop_rollback_started",
        "master_sop_rollback_completed",
        "company_library_provisioned",
        "distribution_event_created",
        "distribution_policy_changed",
        "publication_requested",
        "publication_completed",
        "publication_failed",
        "version_decision_created",
        "version_decision_already_exists",
        "version_decision_superseded",
        "version_decision_creation_failed",
        "new_version_decision_distribution_completed",
        "version_analysis_started",
        "version_analysis_completed",
        "version_analysis_failed",
        "version_analysis_reused",
        "version_analysis_marked_stale"
      ]
    },
    "targetUserId": {
      "type": "string",
      "description": "For role actions: the user whose role was changed"
    },
    "targetRole": {
      "type": "string",
      "description": "For role actions: the role assigned or removed"
    },
    "masterId": {
      "type": "string",
      "description": "For Master Library actions: the affected EssentialSOPMaster.id"
    },
    "masterTitle": {
      "type": "string",
      "description": "Snapshot of the master SOP title at time of action"
    },
    "versionId": {
      "type": "string",
      "description": "For publish actions: the EssentialSOPVersion.id created"
    },
    "versionNumber": {
      "type": "number",
      "description": "For publish actions: the version number"
    },
    "distributionEventId": {
      "type": "string",
      "description": "For distribution actions: the DistributionEvent.id"
    },
    "eventType": {
      "type": "string",
      "description": "For distribution actions: NEW_SOP or NEW_VERSION"
    },
    "distributionPolicy": {
      "type": "string",
      "description": "For distribution actions: the policy applied"
    },
    "publicationMutationKey": {
      "type": "string",
      "description": "Idempotency key for the publication operation"
    },
    "previousVersionId": {
      "type": "string",
      "description": "The currentPublishedVersionId before this publication"
    },
    "resultingVersionId": {
      "type": "string",
      "description": "The currentPublishedVersionId after this publication"
    },
    "selectedCompanyIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "For SELECTED_COMPANIES policy: the company IDs targeted"
    },
    "changeNotes": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "description": "Additional structured context for the action"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "actingUserId",
    "actingUserRole",
    "action",
    "timestamp"
  ]
}