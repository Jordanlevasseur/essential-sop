{
  "name": "EssentialSOPSection",
  "type": "object",
  "description": "Platform Master SOP section content, locked to a specific published version. All direct client access (read/create/update/delete) is blocked via RLS. Sections are written during platform publication and read only through the assignment-gated company preview resolver and platform super-admin backend functions. Direct SDK reads would expose the full content of every Master section across the platform, so client access is denied entirely.",
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "masterId": {
      "type": "string",
      "description": "References EssentialSOPMaster.id"
    },
    "versionId": {
      "type": "string",
      "description": "References EssentialSOPVersion.id \u2014 sections are locked to a specific version"
    },
    "sectionType": {
      "type": "string",
      "enum": [
        "tools",
        "materials",
        "scope",
        "procedure",
        "safety",
        "quality"
      ],
      "description": "Exactly the six section types used in company Jobs. No documentation, completion, or images."
    },
    "title": {
      "type": "string"
    },
    "sortOrder": {
      "type": "number",
      "default": 0
    },
    "contentItems": {
      "type": "array",
      "description": "Ordered array of content items for this section. Each item carries a stable logicalItemId assigned once at creation and preserved through all subsequent edits, moves, and version snapshots. logicalItemId is the authoritative cross-version identity key. Text-based matching (contentType::title) is only a legacy fallback for items lacking logicalItemId.",
      "items": {
        "type": "object",
        "properties": {
          "logicalItemId": {
            "type": "string",
            "description": "Stable cross-version identity. Assigned exactly once when the item is first created on the draft. Preserved verbatim through update_draft edits, duplicate, and publish snapshots. Never regenerated. Format: 'lid_<masterId_prefix>_<random>'."
          },
          "contentType": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "sortOrder": {
            "type": "number"
          },
          "isRequired": {
            "type": "boolean"
          },
          "isCritical": {
            "type": "boolean"
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    }
  },
  "required": [
    "masterId",
    "versionId",
    "sectionType",
    "title"
  ]
}