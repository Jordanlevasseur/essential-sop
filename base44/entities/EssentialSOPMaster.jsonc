{
  "name": "EssentialSOPMaster",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe unique identifier, e.g. 'install-interior-door'"
    },
    "category": {
      "type": "string"
    },
    "trade": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "draft"
    },
    "distributionStatus": {
      "type": "string",
      "enum": [
        "internal",
        "customer_available",
        "retired"
      ],
      "default": "internal",
      "description": "Controls customer distribution eligibility. 'customer_available' = eligible for company provisioning. 'internal' = platform use only. 'retired' = no longer provisioned to new companies. Distinct from defaultDistributionPolicy."
    },
    "defaultDistributionPolicy": {
      "type": "string",
      "enum": [
        "ALL_EXISTING_AND_FUTURE_COMPANIES",
        "FUTURE_COMPANIES_ONLY",
        "SELECTED_COMPANIES",
        "MANUAL"
      ],
      "default": "MANUAL",
      "description": "Which companies should receive this SOP when a publication distribution is executed. Separate from distributionStatus. Only Platform Super Admins may alter this field."
    },
    "defaultSelectedCompanyIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Pre-selected company IDs used when defaultDistributionPolicy is SELECTED_COMPANIES. Must be empty for all other policies."
    },
    "distributionPolicyUpdatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last change to defaultDistributionPolicy or defaultSelectedCompanyIds."
    },
    "distributionPolicyUpdatedByUserId": {
      "type": "string",
      "description": "userId of the Platform Super Admin who last changed the distribution policy."
    },
    "currentPublishedVersionId": {
      "type": "string",
      "description": "ID of the currently active EssentialSOPVersion record"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "slug",
    "status"
  ]
}