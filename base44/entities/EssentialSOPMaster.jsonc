{
  "name": "EssentialSOPMaster",
  "type": "object",
  "description": "Platform Master SOP record \u2014 the central Master Library. All direct client access (read/create/update/delete) is blocked via RLS. Masters are read and mutated exclusively through platform super-admin backend functions (manageMasterSOP, generateMasterSopDraft, provisionCompanyLibrary) that verify an active PlatformMembership(SUPER_ADMIN). Company-facing reads are restricted to Masters actively assigned to the caller's company via resolveCompanyMasterLibrary / resolveCompanyMasterPreview (company-admin membership + ACTIVE ProvisioningRecord). A Technician or any other client MUST NOT list, read, or mutate Master records directly through the SDK \u2014 doing so would bypass the distribution-eligibility and assignment gates and expose the full platform Master Library.",
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe unique identifier, e.g. 'install-interior-door'"
    },
    "category": {
      "type": "string"
    },
    "trade": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Freeform classification tags, e.g. ['Interior', 'Apprentice', 'Safety']"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "draft"
    },
    "distributionStatus": {
      "type": "string",
      "enum": [
        "internal",
        "customer_available",
        "retired"
      ],
      "default": "internal",
      "description": "Controls customer distribution eligibility."
    },
    "defaultDistributionPolicy": {
      "type": "string",
      "enum": [
        "ALL_EXISTING_AND_FUTURE_COMPANIES",
        "FUTURE_COMPANIES_ONLY",
        "SELECTED_COMPANIES",
        "MANUAL"
      ],
      "default": "MANUAL"
    },
    "defaultSelectedCompanyIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "distributionPolicyUpdatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "distributionPolicyUpdatedByUserId": {
      "type": "string"
    },
    "currentPublishedVersionId": {
      "type": "string",
      "description": "ID of the currently active EssentialSOPVersion record"
    },
    "draftRevision": {
      "type": "number",
      "default": 0,
      "description": "Monotonically incremented on every successful draft save. Used for optimistic concurrency control."
    },
    "draftLastSavedByUserId": {
      "type": "string",
      "description": "userId of the admin who last successfully saved this draft."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "slug",
    "status"
  ]
}