{
  "name": "EssentialSOPMaster",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe unique identifier, e.g. 'install-interior-door'"
    },
    "category": {
      "type": "string"
    },
    "trade": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "draft"
    },
    "distributionStatus": {
      "type": "string",
      "enum": [
        "internal",
        "customer_available",
        "retired"
      ],
      "default": "internal",
      "description": "Controls customer distribution eligibility. Only admin/esop_admin may change this. 'customer_available' = eligible for company provisioning. 'internal' = platform use only. 'retired' = no longer provisioned to new companies."
    },
    "currentPublishedVersionId": {
      "type": "string",
      "description": "ID of the currently active EssentialSOPVersion record"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "slug",
    "status"
  ]
}