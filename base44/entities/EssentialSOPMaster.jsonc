{
  "name": "EssentialSOPMaster",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe unique identifier, e.g. 'install-interior-door'"
    },
    "category": {
      "type": "string"
    },
    "trade": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "draft"
    },
    "distributionStatus": {
      "type": "string",
      "enum": [
        "internal",
        "customer_available",
        "retired"
      ],
      "default": "internal",
      "description": "Controls customer distribution eligibility."
    },
    "defaultDistributionPolicy": {
      "type": "string",
      "enum": [
        "ALL_EXISTING_AND_FUTURE_COMPANIES",
        "FUTURE_COMPANIES_ONLY",
        "SELECTED_COMPANIES",
        "MANUAL"
      ],
      "default": "MANUAL"
    },
    "defaultSelectedCompanyIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "distributionPolicyUpdatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "distributionPolicyUpdatedByUserId": {
      "type": "string"
    },
    "currentPublishedVersionId": {
      "type": "string",
      "description": "ID of the currently active EssentialSOPVersion record"
    },
    "draftRevision": {
      "type": "number",
      "default": 0,
      "description": "Monotonically incremented on every successful draft save. Used for optimistic concurrency control. Client must submit expectedDraftRevision matching this value; server rejects stale writes with DRAFT_CONFLICT. Reset to 0 on new draft creation. Not present on non-draft (active/archived) masters \u2014 not applicable once published."
    },
    "draftLastSavedByUserId": {
      "type": "string",
      "description": "userId of the admin who last successfully saved this draft. Returned in DRAFT_CONFLICT responses so the conflicting party can be identified."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "slug",
    "status"
  ]
}