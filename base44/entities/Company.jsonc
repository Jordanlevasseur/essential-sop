{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "accountType": {
      "type": "string",
      "default": "standard"
    },
    "logo": {
      "type": "string"
    },
    "accentColor": {
      "type": "string"
    },
    "ownerUserId": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tradeSpecialties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "customRoleLabels": {
      "type": "object",
      "description": "Optional per-company display labels for role codes. Keys: project_manager, project_lead, technician. Values: display strings. Does not affect permissions."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "closed"
      ],
      "default": "active"
    },
    "planPlaceholder": {
      "type": "string"
    },
    "subscriptionPlanCode": {
      "type": "string",
      "default": "contractor"
    },
    "subscriptionStatus": {
      "type": "string",
      "enum": [
        "prototype",
        "trialing",
        "active",
        "past_due",
        "cancelled",
        "suspended"
      ],
      "default": "prototype"
    },
    "subscriptionSource": {
      "type": "string",
      "enum": [
        "prototype",
        "apple",
        "web",
        "manual",
        "none"
      ],
      "default": "prototype"
    },
    "billingCustomerId": {
      "type": "string"
    },
    "billingSubscriptionId": {
      "type": "string"
    },
    "trialStartedAt": {
      "type": "string",
      "format": "date-time"
    },
    "trialEndsAt": {
      "type": "string",
      "format": "date-time"
    },
    "currentPeriodStartedAt": {
      "type": "string",
      "format": "date-time"
    },
    "currentPeriodEndsAt": {
      "type": "string",
      "format": "date-time"
    },
    "cancelAtPeriodEnd": {
      "type": "boolean",
      "default": false
    },
    "subscriptionCreatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "subscriptionUpdatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "ownerUserId",
    "status"
  ]
}