{
  "name": "CompanyMembership",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "general_manager",
        "project_manager",
        "project_lead",
        "technician"
      ],
      "default": "technician"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "removed"
      ],
      "default": "active"
    },
    "joinedAt": {
      "type": "string",
      "format": "date-time"
    },
    "suspendedAt": {
      "type": "string",
      "format": "date-time"
    },
    "removedAt": {
      "type": "string",
      "format": "date-time"
    },
    "isTestMembership": {
      "type": "boolean",
      "default": false,
      "description": "True for synthetic test-only records seeded during acceptance testing. These are not real authenticated users and cannot sign in."
    }
  },
  "required": [
    "companyId",
    "userId",
    "role",
    "status"
  ]
}