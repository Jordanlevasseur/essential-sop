{
  "name": "CompanyMembership",
  "type": "object",
  "description": "Grants a user membership in a company. Reads are scoped to the user's OWN records only (data.userId === user.id); all writes are blocked at the entity level. Team-roster reads for managers go through resolveTeamRoster (service role); mutations go through manageMember / acceptInvitation / createCompany / migrateToCompany (service role). Direct client reads of another company's memberships are blocked.",
  "rls": {
    "read": {
      "data.userId": "{{user.id}}"
    },
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "companyId": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "general_manager",
        "project_manager",
        "project_lead",
        "technician"
      ],
      "default": "technician"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "removed"
      ],
      "default": "active"
    },
    "joinedAt": {
      "type": "string",
      "format": "date-time"
    },
    "suspendedAt": {
      "type": "string",
      "format": "date-time"
    },
    "removedAt": {
      "type": "string",
      "format": "date-time"
    },
    "isTestMembership": {
      "type": "boolean",
      "default": false,
      "description": "True for synthetic test-only records seeded during acceptance testing. These are not real authenticated users and cannot sign in."
    }
  },
  "required": [
    "companyId",
    "userId",
    "role",
    "status"
  ]
}