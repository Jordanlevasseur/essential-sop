{
  "name": "TemporaryEditGrant",
  "type": "object",
  "description": "Temporary edit-access grant created when an EditRequest is approved. All direct client access (read/create/update/delete) is blocked via RLS. Grants are created exclusively by reviewEditRequest (company-admin authorized) and read/revoked by backend functions (submitRevision, resolveJob, resolveCompanyEditRequests, manageMember) using the service role. SECURITY: submitRevision honors an active TemporaryEditGrant as proof of edit permission \u2014 if create were open, a non-admin user could forge a grant for themselves and submit revisions. Denying all client writes closes that privilege-escalation path.",
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "companyId": {
      "type": "string"
    },
    "editRequestId": {
      "type": "string"
    },
    "jobId": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "approvedSectionTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grantedByUserId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "submitted",
        "revoked",
        "expired"
      ],
      "default": "active"
    },
    "grantedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time"
    },
    "revokedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiredAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "companyId",
    "editRequestId",
    "jobId",
    "userId",
    "approvedSectionTypes",
    "grantedByUserId",
    "status"
  ]
}